<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>SevenZipAIWin11RCM.ShellExt</RootNamespace>
    <AssemblyName>SevenZipAIWin11RCM.ShellExt</AssemblyName>

    <!-- 生成 <Assembly>.comhost.dll：由 COM 激活时加载 .NET 运行时并创建下面的 COM 类 -->
    <EnableComHosting>true</EnableComHosting>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>7-Zip 右键菜单扩展</Product>
    <Company>Minecraftmc22</Company>
    <Copyright>Copyright © 2026 Minecraftmc22</Copyright>
  </PropertyGroup>

</Project>
